 /* wallust template - colors-rofi */

* {
active-background: #BA6962;
active-foreground: #FBF8EE;
normal-background: #1B0B0D;
normal-foreground: #FBF8EE;
urgent-background: #637379;
urgent-foreground: #FBF8EE;

alternate-active-background: #5F8380;
alternate-active-foreground: #FBF8EE;
alternate-normal-background: #1B0B0D;
alternate-normal-foreground: #FBF8EE;
alternate-urgent-background: #1B0B0D;
alternate-urgent-foreground: #FBF8EE;

selected-active-background: #637379;
selected-active-foreground: #FBF8EE;
selected-normal-background: #637379;
selected-normal-foreground: #FBF8EE;
selected-urgent-background: #BA6962;
selected-urgent-foreground: #FBF8EE;

background-color: #1B0B0D;
background: rgba(0,0,0,0.7);
foreground: #FBF8EE;
border-color: #BA6962;

color0: #0F0000;
color1: #B6AF9A;
color2: #9A7C68;
color3: #718684;
color4: #A16E68;
color5: #59656A;
color6: #704F52;
color7: #F0ECDE;
color8: #A8A59B;
color9: #F3EACE;
color10: #CDA58B;
color11: #5F8380;
color12: #BA6962;
color13: #637379;
color14: #82565B;
color15: #F0ECDE;


}

