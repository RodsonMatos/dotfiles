alternate-normal-foreground: #BEB0D0;
alternate-urgent-background: #150824;
alternate-urgent-foreground: #BEB0D0;

selected-active-background: #6CB8B8;
selected-active-foreground: #BEB0D0;
selected-normal-background: #6CB8B8;
selected-normal-foreground: #BEB0D0;
