// ### DEFAULT v4 (Laptop)  - Top ### //
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/UserModules"
  ],
  "layer": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 2,
  "fixed-center": true,
  "ipc": true,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "modules-left": [
    "hyprland/workspaces#number",
    "hyprland/submap",
    "custom/arrow10",
    "hyprland/window"
  ],
  "modules-center": [
    "clock#3"
  ],
  "modules-right": [
    "group/user_tray",
    "custom/weather#2",
    "custom/separator#dot-line",
    "network",
    "custom/separator#dot-line",
    "custom/mullvadvpn",
    "custom/separator#dot-line",
    "custom/swaync"
  ]
}